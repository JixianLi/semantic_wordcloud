{
  "name": "SemanticWordCloud",
  "description": "Word cloud of IEEE VIS 2026 and SC26",
  "views": [
    "Cloud",
    "Filters",
    "TermDetail"
  ],
  "appearance": {
    "default_mode": "dark"
  },
  "panel_layouts": {
    "default_layouts": {
      "xl": [
        {
          "i": "Cloud",
          "type": "borderless",
          "x": 0,
          "y": 0,
          "w": 16,
          "h": 16,
          "visible": true
        },
        {
          "i": "Filters",
          "x": 16,
          "y": 0,
          "w": 6,
          "h": 10,
          "visible": true
        },
        {
          "i": "TermDetail",
          "x": 16,
          "y": 10,
          "w": 6,
          "h": 6,
          "visible": true
        }
      ],
      "lg": [
        {
          "i": "Cloud",
          "type": "borderless",
          "x": 0,
          "y": 0,
          "w": 8,
          "h": 14,
          "visible": true
        },
        {
          "i": "Filters",
          "x": 8,
          "y": 0,
          "w": 4,
          "h": 9,
          "visible": true
        },
        {
          "i": "TermDetail",
          "x": 8,
          "y": 9,
          "w": 4,
          "h": 5,
          "visible": true
        }
      ],
      "sm": [
        {
          "i": "Cloud",
          "type": "borderless",
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 10,
          "visible": true
        },
        {
          "i": "Filters",
          "x": 0,
          "y": 10,
          "w": 4,
          "h": 18,
          "visible": true
        },
        {
          "i": "TermDetail",
          "x": 0,
          "y": 28,
          "w": 4,
          "h": 10,
          "visible": true
        }
      ]
    },
    "breakpoints": {
      "xl": 1440,
      "lg": 800,
      "sm": 0
    },
    "cols": {
      "xl": 22,
      "lg": 12,
      "sm": 4
    },
    "fit_rows": {
      "sm": 13
    }
  },
  "global_data": {
    "corpus_url": "data/corpus.json",
    "scope": "combined",
    "sources": [
      "accepted_entries",
      "keynote",
      "website"
    ],
    "excluded_tracks": [],
    "balance_venues": true,
    "term_limit": 150,
    "include_phrases": true,
    "neighbors_url": "data/neighbors.json",
    "embedding_weight": 0.5,
    "links_per_term": 3,
    "link_strength": 0.6,
    "show_all_links": false
  }
}
